# Employmentmaxxing Configuration
# Copy this to .env and fill in your values

# Gemini API Key (get free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Scrape schedule (hours between scrape cycles)
SCRAPE_INTERVAL_HOURS=3

# Debug mode
DEBUG=true

# ATS Discovery & Crawler Settings (optional)
# ATS_CONCURRENCY_LIMIT=15
# ATS_PER_HOST_CONCURRENCY=3
# ATS_GLOBAL_SCAN_ENABLED=true

